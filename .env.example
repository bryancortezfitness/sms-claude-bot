# Copy to .env for local testing. On Render, set these in the dashboard (Environment tab).

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# From console.twilio.com (Account Info on the dashboard home)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Twilio number you bought, E.164 format with country code
TWILIO_FROM_NUMBER=+18885551234

# YOUR personal cell, E.164. Only this number can talk to the bot.
OWNER_NUMBER=+13105557788

# Any random string you make up. Protects the /send endpoint from strangers.
SEND_SECRET=change-me-to-something-random

# Optional overrides
CLAUDE_MODEL=claude-sonnet-4-6
PORT=3000
